<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <RiderHost Condition="'$(RiderHost)' == '' and '$(RIDER_HOME)' != ''">$(RIDER_HOME)/lib/ReSharperHost</RiderHost>
  </PropertyGroup>
</Project>
